#!/usr/bin/env python3
import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from inventory_format import render_text


def main():
    parser = argparse.ArgumentParser(description="Print inventory as tab-separated text")
    parser.add_argument("--input", type=Path, required=True, help="inventory JSON file")
    parser.add_argument("--warehouse", help="warehouse name to retain")
    args = parser.parse_args()
    try:
        data = json.loads(args.input.read_text(encoding="utf-8"))
        items = data["items"]
        if not isinstance(items, list):
            raise ValueError("items must be a list")
        seen = set()
        for item in items:
            if not isinstance(item, dict):
                raise ValueError("each item must be an object")
            sku, warehouse, quantity = item["sku"], item["warehouse"], item["on_hand"]
            if any(not isinstance(value, str) or not value or "\t" in value or "\n" in value or "\r" in value for value in (sku, warehouse)):
                raise ValueError("SKU and warehouse must be nonempty single-line strings without tabs")
            if type(quantity) is not int or quantity < 0:
                raise ValueError("on_hand must be a nonnegative integer")
            identity = (sku, warehouse)
            if identity in seen:
                raise ValueError("duplicate SKU and warehouse")
            seen.add(identity)
        print(render_text(item for item in items if args.warehouse is None or item["warehouse"] == args.warehouse), end="")
    except (OSError, ValueError, KeyError, TypeError) as exc:
        parser.error(f"invalid inventory: {exc}")


if __name__ == "__main__":
    main()
