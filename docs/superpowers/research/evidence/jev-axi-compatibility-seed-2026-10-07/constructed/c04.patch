--- /dev/null
+++ b/report_renderers.py
@@ -0,0 +1,12 @@
+import json
+
+HEADER = "sku\twarehouse\ton_hand\n"
+
+
+def render_text(items):
+    return HEADER + "".join(f"{item['sku']}\t{item['warehouse']}\t{item['on_hand']}\n" for item in reversed(list(items)))
+
+
+def render_json(items, warehouse):
+    return json.dumps({"schema": "inventory-report/v1", "warehouse": warehouse,
+                       "items": [{"sku": item["sku"], "warehouse": item["warehouse"], "on_hand": item["on_hand"]} for item in items]}, ensure_ascii=False) + "\n"
