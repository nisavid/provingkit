{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node {scratch}/pilot-hook.mjs pre {jev-package} {scratch}/sys1-supervision-m0vgmb3t/manifest.json {scratch}/sys1-supervision-m0vgmb3t/records/choice_missing-no_supervision.hook.jsonl {scratch}/sys1-supervision-m0vgmb3t/records/choice_missing-no_supervision.first-read {scratch}/sys1-supervision-m0vgmb3t/project/brief.txt no_supervision",
