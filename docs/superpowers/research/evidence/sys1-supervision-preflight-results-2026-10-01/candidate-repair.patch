--- a/native-supervision/test_preflight.py
+++ b/native-supervision/test_preflight.py
@@ -75,0 +76,18 @@
+
+    def test_codex_stop_id_can_repeat_in_distinct_turns(self):
+        from hook_receipts import HookReceipts
+        tracker = HookReceipts("codex", "/fixture/.codex/hooks.json")
+        for index, turn in enumerate(("first", "second")):
+            run = {"id": "stop:11:project-hook", "eventName": "stop",
+                   "sourcePath": "/fixture/.codex/hooks.json", "handlerType": "command",
+                   "executionMode": "sync", "entries": [], "status": "running",
+                   "scope": "turn", "startedAt": 123 + index}
+            event = {"method": "hook/started", "params": {"threadId": "session", "turnId": turn, "run": run}}
+            self.assertTrue(tracker.receive(event, "session"))
+            event["method"] = "hook/completed"
+            run["status"] = "completed"
+            self.assertTrue(tracker.receive(event, "session"))
+            event["method"] = "hook/started"
+            run["status"] = "running"
+            with self.assertRaisesRegex(ValueError, "duplicate hook start"):
+                tracker.receive(event, "session")
