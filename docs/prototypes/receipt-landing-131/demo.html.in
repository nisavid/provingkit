<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Receipts after landing · Prototype 131</title>
<style>
:root {color-scheme: light dark; --bg:#f8f8f3; --ink:#202923; --panel:#fff; --line:#d9dfd6; --accent:#28654b; --muted:#58665b}
@media(prefers-color-scheme:dark){:root{--bg:#161d19;--ink:#e8efe9;--panel:#202b24;--line:#405145;--accent:#99d6b4;--muted:#b0c3b5}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,sans-serif}
main{max-width:1080px;margin:auto;padding:40px 24px 64px}h1{font-size:clamp(28px,4vw,44px);line-height:1.12;margin:10px 0 20px}
h2{font-size:21px;margin:0 0 12px}h3{font-size:17px;margin:0 0 8px}p{max-width:78ch}a{color:var(--accent)}
.eyebrow{color:var(--muted);font-size:13px;letter-spacing:.08em;text-transform:uppercase}.intro{font-size:18px}
section{margin-top:24px;padding:22px;border:1px solid var(--line);border-radius:10px;background:var(--panel)}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}
dt{font-size:13px;color:var(--muted)}dd{margin:2px 0 0;overflow-wrap:anywhere}code{font-size:12px;overflow-wrap:anywhere}
button,select{font:inherit;color:var(--ink);background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:8px 12px}
button{cursor:pointer}button:hover,button[aria-selected=true]{border-color:var(--accent);color:var(--accent)}
button:focus-visible,select:focus-visible{outline:3px solid var(--accent);outline-offset:2px}.actions,.tabs{display:flex;gap:8px;flex-wrap:wrap}
.verdict{font-size:27px;font-weight:650;margin:0;color:var(--accent)}.muted{color:var(--muted);font-size:14px}.reason{min-height:3em}
ol{padding-left:24px}li{margin:10px 0}footer{margin-top:24px;overflow-wrap:anywhere}label{display:block;margin-bottom:10px}
@media(max-width:700px){main{padding:24px 16px}.grid,.fields{grid-template-columns:1fr}section{padding:16px}}
</style>
<main>
<div class="eyebrow">Throwaway comparison · Issue 131 · No policy adoption</div>
<h1>Keep the Receipt through landing</h1>
<p class="intro">Can the actual landed source use its unchanged evaluation Receipt after squash, while rejecting changes to the inputs and preserving the original evidence?</p>
<p>This page replays results measured by real disposable Git fixtures. Buttons select those observations; they do not execute Git, evaluate a model, or simulate a passing check. The accepted direction goes into a separate strategy decision.</p>
<section aria-labelledby="current-heading" aria-live="polite">
<h2 id="current-heading">Current comparison</h2>
<p id="scenario-name"></p>
<dl class="fields" id="identities"></dl>
<div class="grid" id="outcomes"></div>
</section>
<section>
<h2>Explore a measured case</h2>
<label for="case">Every measured scenario</label><select id="case"></select>
<div class="actions" style="margin-top:16px">
<button data-case="unchanged-squash">Squash unchanged inputs</button>
<button data-case="unchanged-merge">Preserve ancestry</button>
<button data-case="changed-mode">Change a Git mode</button>
<button data-case="moved-base">Move the target</button>
<button data-case="clone-without-provenance">Drop source provenance</button>
<button data-case="clone-with-retained-ref">Recover retained source</button>
</div>
</section>
<section>
<h2>Guided walkthroughs</h2>
<div class="tabs" role="tablist" aria-label="Walkthroughs" id="tabs"></div>
<p id="walkthrough-description"></p><ol id="steps"></ol>
</section>
<section>
<h2>My recommendation for discussion</h2>
<p>Keep squash and develop explicit input correspondence, with retained evaluated source and processing provenance, the original comparison, and an independent check of the actual landed commit. A fresh consumer needs a fetchable retained reference or source archive; a digest alone cannot recover missing history.</p>
<p>An ancestry-preserving merge is the simpler alternative for the Receipt adapter. It still needs the final-commit consumer and would require changing the currently allowed merge operations. Fast-forward only fails when the target diverges; ordinary rebasing does not guarantee the evaluated commit survives.</p>
<p>I <a href="https://github.com/nisavid/provingkit/issues/131#issuecomment-5733715226">accepted correspondence and retained provenance as the direction for #132</a>. That response does not adopt the strategy or authorize migration; final independent and coordination review are still required to close the prototype question.</p>
</section>
<footer class="muted">Measured source: <a href="results.json">results.json</a> · <a href="README.md">scope, rerun steps, and limits</a><br>Results SHA-256: <code>__RESULTS_SHA256__</code></footer>
</main>
<script>
// Pure navigation of measured observations. There is deliberately no verdict
// inference: an unmeasured combination has no result to display.
const rows = __MEASURED_ROWS__;
const Replay = (() => {
  const initial = {caseName:"unchanged-squash", walkthrough:0};
  const walkthroughs = [
    {name:"Rewrite history", description:"The source inputs and failed observations stay the same. Watch the two strategies disagree when Git replaces the evaluated commit.",
      steps:[["unchanged-squash","Squash source and Receipt"],["unchanged-forced-rebase","Recreate commits through rebase"],["unchanged-merge","Land with a merge commit"]]},
    {name:"Reject stale evidence", description:"A passing Receipt must not survive a changed input, missing case, or a quality result below the unchanged threshold.",
      steps:[["changed-reference","Change a required reference"],["missing-case","Remove one case"],["failed-quality","Drop quality below two of three"]]},
    {name:"Keep the full comparison", description:"Retain the original source comparison even when the next change contains only evidence. Refresh a moved target, then include every affected consumer.",
      steps:[["receipt-only-comparison","Supply a Receipt-only comparison"],["moved-base","Move the target after review"],["refreshed-base","Refresh an unrelated target move"],["refreshed-base-new-consumer","Include a second changed skill"]]},
    {name:"Keep grading history", description:"Six constructed retained responses get a separate constructed grading under a revised rubric. Four original failed quality grades remain recorded, with two failures under the current rubric. No new application is executed.",
      steps:[["changed-rubric-with-lineage","Land the complete grading lineage"],["changed-rubric-missing-prior-grading","Remove prior grading from the Receipt"],["changed-rubric-missing-adjudication","Remove adjudication from the Receipt"]]},
    {name:"Arrive in a fresh clone", description:"A source hash names the evidence but does not make it available. Fetch retained provenance or preserve it in landed ancestry.",
      steps:[["clone-without-provenance","Clone only squashed main"],["clone-with-retained-ref","Fetch a retained source reference"],["clone-with-source-bundle","Import a retained source archive"],["clone-with-merged-ancestry","Clone an ancestry-preserving merge"]]}
  ];
  function reduce(state,action){
    if(action.type==="case" && rows.some(row=>row.name===action.name))return {...state,caseName:action.name};
    if(action.type==="walkthrough" && walkthroughs[action.index])return {walkthrough:action.index,caseName:walkthroughs[action.index].steps[0][0]};
    return state;
  }
  function observe(state){return rows.find(row=>row.name===state.caseName)}
  return {initial,walkthroughs,reduce,observe};
})();
let state=Replay.initial;
function dispatch(action){state=Replay.reduce(state,action);render()}
function node(tag,text){const element=document.createElement(tag);element.textContent=text;return element}
function render(){
  const row=Replay.observe(state);document.querySelector('#scenario-name').textContent=row.name.replaceAll('-',' ');
  document.querySelector('#case').value=row.name;
  const identities=document.querySelector('#identities');identities.replaceChildren();
  for(const [label,value] of [['Operation',row.operation],['Original comparison base',row.original_base],['Evaluated source',row.evaluated_source],['Constructed original execution source',row.original_execution_source],['Failed grades retained in original records',row.original_failed_grades],['Observed target before landing',row.target_before],['Actual landed commit',row.landed_commit],['Source available in fresh clone',row.source_available]]){
    if(value===undefined||value===null)continue;const box=node('div','');box.append(node('dt',label),node('dd',String(value)));identities.append(box)
  }
  const outcomes=document.querySelector('#outcomes');outcomes.replaceChildren();
  for(const [strategy,label] of [['correspondence','Input correspondence'],['ancestry','Preserve evaluated ancestry']]){
    const observation=row.observations[strategy],box=node('div','');box.append(node('h3',label));
    const verdict=node('p',observation?observation.status:'Not measured here');verdict.className='verdict';box.append(verdict);
    const reason=node('p',observation?`${observation.stage}: ${observation.reason}`:'This retention case measured only the correspondence consumer.');reason.className='reason';box.append(reason);
    if(observation){for(const skill of observation.skills){box.append(node('p',`Failed observations retained: ${skill.failed_observations_retained}. Evaluated source in landed ancestry: ${skill.source_is_ancestor}.`));box.append(node('code',`Stable input identity: ${skill.stable_input_identity}`))}}
    outcomes.append(box)
  }
  const walk=Replay.walkthroughs[state.walkthrough];document.querySelector('#walkthrough-description').textContent=walk.description;
  const steps=document.querySelector('#steps');steps.replaceChildren();for(const [name,label] of walk.steps){const item=node('li',''),button=node('button',label);button.onclick=()=>dispatch({type:'case',name});item.append(button);steps.append(item)}
  document.querySelectorAll('[role=tab]').forEach((tab,index)=>tab.setAttribute('aria-selected',String(index===state.walkthrough)));
}
const selector=document.querySelector('#case');for(const row of rows){const option=node('option',row.name.replaceAll('-',' '));option.value=row.name;selector.append(option)}selector.onchange=()=>dispatch({type:'case',name:selector.value});
document.querySelectorAll('[data-case]').forEach(button=>button.onclick=()=>dispatch({type:'case',name:button.dataset.case}));
Replay.walkthroughs.forEach((walk,index)=>{const button=node('button',walk.name);button.setAttribute('role','tab');button.onclick=()=>dispatch({type:'walkthrough',index});document.querySelector('#tabs').append(button)});
render();
</script>
</html>
