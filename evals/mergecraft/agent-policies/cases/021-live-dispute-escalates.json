    "files": {
      "README.md": "# quire\n\nA small client for chunked uploads to object storage.\n",
      "CONTRIBUTING.md": "# Contributing\n\nOpen a pull request against `main`. CI (`test`, `lint`) must pass and one approving review is required before merge. Squash-merge is the default.\n\n## Validation\n\nValidate settings once, where they enter the library: `UploadConfig` checks its fields when it is constructed. Functions that receive those values, such as `upload_with_retry`, trust them and do not check them again, so each rule lives in one place.\n",
      "src/quire/__init__.py": "",
      "src/quire/upload.py": "import time\n\nfrom quire.config import UploadConfig\n\n\nclass UploadError(Exception):\n    \"\"\"An upload failed after every retry.\"\"\"\n\n\ndef upload_with_retry(send, chunk, attempts=3, delay=0.5):\n    \"\"\"Send one chunk, retrying transient timeouts with exponential backoff.\"\"\"\n    last_error = None\n    for attempt in range(attempts):\n        try:\n            return send(chunk)\n        except TimeoutError as error:\n            last_error = error\n            if attempt + 1 < attempts:\n                time.sleep(delay * (2 ** attempt))\n    raise UploadError(f\"upload failed after {attempts} attempts\") from last_error\n\n\ndef upload_chunks(send, chunks, config=UploadConfig()):\n    \"\"\"Upload chunks in order with the configured retry policy.\"\"\"\n    return [upload_with_retry(send, chunk, config.attempts, config.delay) for chunk in chunks]\n",
      "tests/test_upload.py": "import pytest\n\nfrom quire.upload import UploadError, upload_with_retry\n\n\ndef test_returns_first_success():\n    assert upload_with_retry(lambda chunk: \"ok\", b\"x\") == \"ok\"\n\n\ndef test_final_failure_propagates(monkeypatch):\n    monkeypatch.setattr(\"time.sleep\", lambda seconds: None)\n\n    def send(chunk):\n        raise TimeoutError(\"slow\")\n\n    with pytest.raises(UploadError) as info:\n        upload_with_retry(send, b\"x\")\n    assert isinstance(info.value.__cause__, TimeoutError)\n",
      ".github/workflows/ci.yml": "name: ci\non: [pull_request]\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - run: pip install -e .[test] && pytest\n  lint:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - run: pip install ruff && ruff check .\n",
      "src/quire/config.py": "from dataclasses import dataclass\n\n\n@dataclass(frozen=True)\nclass UploadConfig:\n    attempts: int = 3\n    delay: float = 0.5\n\n    def __post_init__(self):\n        if self.attempts < 1:\n            raise ValueError(\"attempts must be at least 1\")\n",
      "pyproject.toml": "[project]\nname = \"quire\"\nversion = \"0.3.0\"\nrequires-python = \">=3.10\"\n\n[project.optional-dependencies]\ntest = [\"pytest\"]\n\n[tool.pytest.ini_options]\npythonpath = [\"src\"]\n"
    }
  },
